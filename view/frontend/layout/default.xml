<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header.container">
            <block name="warning-block" template="Magedia_Demo::warning_reset_time.phtml" before="-">
                <arguments><argument name="marketplace_url_view_model" xsi:type="object">Magedia\Demo\ViewModel\MarketplaceUrl</argument></arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="magedia-demo-analytics" template="Magedia_Demo::analytics.phtml">
                <arguments>
                    <argument name="marketplace_url_view_model" xsi:type="object">Magedia\Demo\ViewModel\MarketplaceUrl</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
