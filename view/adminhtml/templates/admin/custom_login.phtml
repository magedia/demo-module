<?php
/**
 * @var \Magento\Framework\View\Element\AbstractBlock $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

// Public demo credentials -- they are printed on this page by design.
$demoUsername = 'demo';
$demoPassword = 'demo1234';
?>

<form method="post" action="" id="login-form" data-mage-init='{"form": {}, "validation": {}}' autocomplete="off">
    <fieldset class="admin__fieldset">
        <legend class="admin__legend">
            <span><?= $escaper->escapeHtml(__('Welcome, please sign in')) ?></span>
        </legend><br/>
        <input name="form_key" type="hidden" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>" />

        <!--
            The credentials are submitted from hidden inputs, and the visible
            boxes below carry no name and no type="password". Password managers
            key on a password input to decide a form is a login form: with none
            present they neither offer to fill nor overwrite anything, which
            readonly alone never achieved. Whatever a manager does to the
            visible boxes, what posts is what is written here.
        -->
        <input type="hidden" name="login[username]" value="<?= $escaper->escapeHtmlAttr($demoUsername) ?>" />
        <input type="hidden" name="login[password]" value="<?= $escaper->escapeHtmlAttr($demoPassword) ?>" />

        <div class="admin__field _required field-username">
            <label for="username" class="admin__field-label">
                <span><?= $escaper->escapeHtml(__('Username')) ?></span>
            </label>
            <div class="admin__field-control">
                <input id="username"
                       class="admin__control-text"
                       type="text"
                       value="<?= $escaper->escapeHtmlAttr($demoUsername) ?>"
                       tabindex="-1"
                       autocomplete="off"
                       data-lpignore="true"
                       data-1p-ignore
                       data-bwignore
                       data-form-type="other"
                       readonly
                />
            </div>
        </div>
        <div class="admin__field _required field-password">
            <label for="login" class="admin__field-label">
                <span><?= $escaper->escapeHtml(__('Password')) ?></span>
            </label>
            <div class="admin__field-control">
                <input id="login"
                       class="admin__control-text demo-password"
                       type="text"
                       value="<?= $escaper->escapeHtmlAttr($demoPassword) ?>"
                       tabindex="-1"
                       autocomplete="off"
                       data-lpignore="true"
                       data-1p-ignore
                       data-bwignore
                       data-form-type="other"
                       readonly
                />
            </div>
        </div>
        <?= $block->getChildHtml('form.additional.info') ?>
        <div class="form-actions">
            <button
                <?php $block->getUiId(); ?>
                class="action-login action-primary">
                <span><?= $escaper->escapeHtml(__('Sign in')) ?></span>
            </button>
        </div>
    </fieldset>
</form>
<?php
// Renders the demo password as dots without a type="password" input, which is
// what would bring the password managers back. Browsers without support just
// show the credential in clear -- it is public either way.
$maskStyle = '.demo-password { -webkit-text-security: disc; text-security: disc; }';
?>
<?= /* @noEscape */ $secureRenderer->renderTag('style', [], $maskStyle, false) ?>
