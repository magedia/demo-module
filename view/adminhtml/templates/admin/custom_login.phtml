$reassertCredentials = <<<JS
// Password managers overwrite these fields even though they are readonly, so
// the form submits someone else's saved credentials instead of the demo ones.
// Every such attempt counts as a failed login for "demo", and once enough
// accumulate Magento demands a captcha that this template never renders --
// locking every visitor out of the demo admin. Re-assert the values on submit.
(function () {
    var form = document.getElementById('login-form');

    if (!form) {
        return;
    }

    form.addEventListener('submit', function () {
        var credentials = {username: 'demo', login: 'demo1234'};

        Object.keys(credentials).forEach(function (id) {
            var field = document.getElementById(id);

            if (field) {
                field.value = credentials[id];
            }
        });
    }, true);
})();
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $reassertCredentials, false) ?>
